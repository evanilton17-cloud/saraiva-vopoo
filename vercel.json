{ "version": 2,
  "rewrites": [
    { "source": "/painel.html", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" } ] },
    { "source": "/favicon.svg", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
  ] }