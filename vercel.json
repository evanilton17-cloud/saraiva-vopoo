{ "version": 2,
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/favicon.svg", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
  ] }